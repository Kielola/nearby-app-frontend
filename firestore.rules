rules_version = '2';

// ============================================================================
// Nearby — Firestore security rules
//
// These were rewritten against what the code ACTUALLY does, not what it did
// before the backend migration. Several rules in the previous version guarded
// collections the client no longer touches, and two of them called a helper
// that could never return true. The dead rules have been removed rather than
// left in, because a rule that silently denies is far harder to diagnose than
// a rule that does not exist.
//
// What moved to the NestJS backend and therefore no longer needs a rule here:
//
//   friendships         → friendsApi        (was: /friendships/{pairId})
//   friend requests     → friendsApi        (was: /friend_requests/{id})
//   direct messages     → chatApi + Socket.IO (was: /direct_messages/{id})
//   notifications       → notificationsApi  (was: /notifications/{id})
//   call signalling     → Socket.IO
//   meetups and ratings → meetupsApi        (was: /meetups, /meetupRatings)
//   user profile reads  → usersApi          (/users/{uid} is still read as a
//                                            cache, so its rule stays)
//
// IMPORTANT: the backend uses the Firebase Admin SDK, which BYPASSES these
// rules entirely. Nothing here restricts the server. These rules only govern
// what a signed-in browser may read and write directly.
//
// Collections intentionally NOT open: anything not matched below falls through
// to the catch-all at the end and is denied.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // The signed-in user's own document and their content.
    //
    // /users/{uid} is still read directly by the client (the profile screen
    // falls back to it when the API is slow, and ExploreTab reads other
    // neighbours' documents), so it stays readable to any signed-in user.
    //
    // Ratings and trust aggregates are computed by the backend now — no client
    // can write to another user's document at all. That removes the entire
    // class of bug where one client's local running average disagreed with
    // everyone else's.
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(userId);

      // The signed-in user's own private message mirror. Owner-only, because
      // these documents are messages this device wrote.
      match /messages/{messageId} {
        allow read, write: if isOwner(userId);
      }

      // Stories. Anyone signed in may read them — that is what makes a story
      // visible. Only the author may write, with ONE exception that the app
      // genuinely relies on: a viewer appends themselves to `viewers` so the
      // author can see who watched. That single key is the only thing a
      // non-owner is permitted to touch, so a viewer cannot edit or delete
      // someone else's story.
      match /stories/{storyId} {
        allow read: if signedIn();
        allow write: if isOwner(userId)
          || (
            signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
          );
      }

      // Posts and highlights on a profile page.
      match /posts/{postId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }

      match /highlights/{highlightId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }
    }

    // ------------------------------------------------------------------
    // Per-user settings and location.
    //
    // Location documents are owner-write, signed-in-read: the radar needs to
    // read every nearby neighbour's last known position to place them, which
    // is the whole point of the app, and is why this is not owner-read.
    // ------------------------------------------------------------------
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /visibilitySettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /locations/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(userId);
    }

    match /liveLocations/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(userId);
    }

    match /presence/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(userId);
    }

    // ------------------------------------------------------------------
    // Content the whole signed-in user base shares: the community feed, the
    // meetup board and the safe-place directory.
    //
    // These are deliberately open to any signed-in user. They are public
    // content by design. If this app ever grows moderation, this is the block
    // to tighten first — a signed-in user can currently write here freely.
    // ------------------------------------------------------------------
    match /posts/{postId} {
      allow read, write: if signedIn();
    }

    match /safeMeetups/{placeId} {
      allow read, write: if signedIn();
    }

    match /communities/{communityId} {
      allow read, write: if signedIn();
    }

    match /community_discussions/{discussionId} {
      allow read, write: if signedIn();
    }

    // ------------------------------------------------------------------
    // Everything else is denied, including any collection added to the code
    // later. A new feature that talks to Firestore directly will fail loudly
    // rather than silently being world-writable.
    //
    // Note: the boot-time probe at `getDocFromServer(doc(db, 'test',
    // 'connection'))` in useNearbyController lands here and is denied. That is
    // harmless — the call is wrapped in a try/catch that only logs the
    // "client is offline" case, so a permission-denied is swallowed.
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
