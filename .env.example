# ---------------------------------------------------------------------------
# Nearby frontend — build-time environment
#
# IMPORTANT: every VITE_* var below is baked into the bundle AT BUILD TIME by
# Vite. Changing one in your host's dashboard does NOTHING until you rebuild.
# If any of these is missing, the app now fails loudly at startup instead of
# silently falling back to localhost or to someone else's Firebase project.
# ---------------------------------------------------------------------------

# REQUIRED — your NestJS backend. Must be reachable from the user's browser.
VITE_API_URL="https://api.yourdomain.com"
VITE_SOCKET_URL="https://api.yourdomain.com"

# REQUIRED — YOUR Firebase project.
# The backend verifies ID tokens against FIREBASE_PROJECT_ID, so these two
# MUST refer to the same project or every API call returns 401.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
# Leave empty to use the (default) Firestore database.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# REQUIRED for photo/video uploads. Cloudinary console -> Settings -> Upload
# -> Upload presets -> Add -> Signing Mode: Unsigned.
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# STRONGLY RECOMMENDED — TURN relay for calls.
#
# Without a relay, calls will NOT connect on Nigerian mobile networks. Most
# subscribers are behind carrier-grade NAT: both callers share a public address
# with thousands of others, and the carrier drops unsolicited inbound packets.
# STUN can discover each peer's address but cannot grant permission to use it,
# so ICE finds candidates it cannot connect to, the call rings, and then fails.
# This is the single most likely cause of "the call isn't working".
#
# The app falls back to Metered's public shared Open Relay so calls still have a
# relay to try, but that is a free demo service used by many applications — it
# is rate-limited and often saturated. It is not a launch configuration.
#
# Free options (no card for the first): metered.ca — 500 MB/month free, and
# 20 GB/month if a card is added. It stops at the limit rather than charging.
# Paste the values from the Metered dashboard below, then REBUILD — Vite bakes
# these in at build time, so changing them without a rebuild does nothing.
#
# VITE_TURN_URLS="turn:a.relay.metered.ca:80,turn:a.relay.metered.ca:443,turns:a.relay.metered.ca:443?transport=tcp"
# VITE_TURN_USERNAME=""
# VITE_TURN_CREDENTIAL=""

# OPTIONAL — the map falls back to Leaflet/OpenStreetMap when this is absent,
# which is the $0 option and works fine. Add a key only if you want Google.
VITE_GOOGLE_MAPS_API_KEY=""

# NOT USED ANY MORE. The AI endpoints (my-ai-chat, icebreaker) now live in the
# NestJS backend, which reads GEMINI_API_KEY from ITS OWN environment. Setting
# it here does nothing. Configure it on your backend host instead (Render ->
# Environment). Leaving it set here is harmless but misleading.
