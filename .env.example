# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Your Google Maps JavaScript API, Places API, and Geocoding API key.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# PRODUCTION FIREBASE CONFIGURATION (For custom self-owned production project)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_FIREBASE_MEASUREMENT_ID"
# Optional: Only needed if you use multiple or non-default Firestore database IDs. Keep empty to use '(default)'.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# CLOUDINARY (used for all image/video uploads instead of paid Firebase Storage)
# 1. Free account at https://cloudinary.com
# 2. Cloud name shown on your Cloudinary console dashboard
# 3. Settings (gear icon) -> Upload -> Upload presets -> Add upload preset -> Signing Mode: Unsigned
VITE_CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
VITE_CLOUDINARY_UPLOAD_PRESET="YOUR_UNSIGNED_UPLOAD_PRESET"


# New NestJS backend — see nearby-backend repo.
VITE_API_URL="http://localhost:3000"
VITE_SOCKET_URL="http://localhost:3000"
